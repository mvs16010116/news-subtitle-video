{
  "name": "news-subtitle-video",
  "version": "1.0.0",
  "description": "News text to vertical subtitled video with TTS voiceover and word-level karaoke highlight",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@remotion/captions": "4.0.503",
    "@remotion/cli": "4.0.503",
    "@remotion/fonts": "4.0.503",
    "@remotion/google-fonts": "^4.0.503",
    "@remotion/media": "4.0.503",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.503"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.503",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
